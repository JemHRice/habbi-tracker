# Copy to .env and adjust. .env is gitignored; never commit real values.

# --- Database -------------------------------------------------------------
# Local development (SQLite, the default if unset):
DATABASE_URL=sqlite+pysqlite:///./habit_tracker.db
# Local Postgres via docker-compose (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://habit:habit@localhost:5433/habit_tracker
# Production (Neon) is injected by the host; never store it here.

# --- Date dimension -------------------------------------------------------
DIM_DATE_START=2025-01-01
DIM_DATE_END=2030-12-31

# --- Domain behaviour -----------------------------------------------------
BACKFILL_MAX_DAYS=60
DEFAULT_TIMEZONE=Australia/Sydney

# Exact number of digits a PIN must have.
PIN_LENGTH=6

# --- API ------------------------------------------------------------------
# Comma-separated origins allowed to call the API. Defaults are Vite's dev
# server; production sets this to the deployed frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Failed PIN attempts before a cooldown, and how long that cooldown lasts.
PIN_THROTTLE_MAX_ATTEMPTS=10
PIN_THROTTLE_COOLDOWN_SECONDS=300

# --- Seed PINs (development only) -----------------------------------------
# The seed script reads PINs from here so no PIN is hardcoded in the repo.
# These are throwaway placeholders: change them before seeding anywhere real.
SEED_USER_A_PIN=123456
SEED_USER_B_PIN=567890
